{
  "name": "dbgate-plugin-pglite",
  "version": "1.0.0",
  "description": "PGlite connector plugin for DbGate ![icon](https://raw.githubusercontent.com/papodaca/dbgate-plugin-pglite/main/icon.svg)",
  "keywords": [
    "dbgate",
    "dbgateplugin",
    "pglite",
    "postgres",
    "postgresql",
    "wasm"
  ],
  "homepage": "https://github.com/papodaca/dbgate-plugin-pglite",
  "bugs": {
    "url": "https://github.com/papodaca/dbgate-plugin-pglite/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/papodaca/dbgate-plugin-pglite.git"
  },
  "license": "MIT",
  "author": "Ethan Apodaca",
  "main": "dist/backend.js",
  "files": [
    "dist",
    "icon.svg",
    "LICENSE"
  ],
  "scripts": {
    "build:frontend": "webpack --config webpack-frontend.config.js",
    "build:frontend:watch": "webpack --watch --config webpack-frontend.config.js",
    "build:backend": "webpack --config webpack-backend.config.js",
    "build": "yarn build:frontend && yarn build:backend && node scripts/copy-pglite.js",
    "plugin": "yarn build && yarn pack && dbgate-plugin dbgate-plugin-pglite",
    "plugout": "dbgate-plugout dbgate-plugin-pglite",
    "prepublishOnly": "yarn build"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-age": "^0.0.9",
    "@electric-sql/pglite-icu-full": "^0.1.0",
    "@electric-sql/pglite-pg_hashids": "^0.0.9",
    "@electric-sql/pglite-pg_ivm": "^0.0.9",
    "@electric-sql/pglite-pg_textsearch": "0.0.10",
    "@electric-sql/pglite-pg_uuidv7": "^0.0.9",
    "@electric-sql/pglite-pgmq": "^0.0.6",
    "@electric-sql/pglite-pgtap": "^0.0.9",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@electric-sql/pglite-postgis": "^0.2.8",
    "@electric-sql/pglite-tools": "^0.4.8",
    "dbgate-query-splitter": "^4.12.0",
    "dbgate-tools": "^6.5.0"
  },
  "devDependencies": {
    "dbgate-plugin-tools": "^1.0.8",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}
